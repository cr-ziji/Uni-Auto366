# react-native-nitro-zlib@0.3.1 still declares
#   peerDependencies: { "react-native-nitro-modules": "^0.35.0" }
# but RN 0.88 requires >= 0.37 (the JSI-bindings protocol gained a callInvoker
# parameter, see reports/NATIVE_MODULES_REPORT.md). The zlib pod compiles and
# links against 0.37 fine, so the range check must not block `npm install`.
legacy-peer-deps=true
