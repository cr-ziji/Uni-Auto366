{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["react", "node", "jest"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "App.tsx", "index.js", "__tests__"],
  "exclude": ["node_modules", "android", "ios", "src/webassets", "src/generated"]
}
